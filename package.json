{
  "name": "okaeri-resort-system",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:dev": "tsc -b && vite build",
    "build:full": "npm run build && npm run build:functions",
    "build:functions": "rm -rf dist/functions && cp -r functions dist/functions",
    "build:size": "node scripts/bundle-size.js",
    "clean": "rm -rf dist node_modules/.vite functions/.wrangler",
    "deploy": "npm run build:full && npx wrangler pages deploy dist",
    "deploy:preview": "npm run build:full && npx wrangler pages deploy dist --branch preview",
    "dev": "vite",
    "dev:cf": "concurrently \"npm:dev:vite\" \"npm:dev:wrangler\" --kill-others",
    "dev:vite": "vite --clearScreen false",
    "dev:wrangler": "wrangler pages dev public --port 8788 --local",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "seed:roles:dev": "tsx scripts/seed-dev-roles.ts",
    "seed:roles:verify": "tsx scripts/verify-roles.ts",
    "test": "vitest",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:performance": "vitest run --grep performance",
    "test:run": "vitest run",
    "test:security": "vitest run --grep security",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check && npm run lint && npm run test:run",
    "verify:fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.89.0",
    "@tanstack/react-query-devtools": "^5.89.0",
    "@tanstack/react-router": "^1.131.49",
    "@tanstack/react-router-devtools": "^1.131.50",
    "@tanstack/react-table": "^8.21.3",
    "@types/dompurify": "^3.0.5",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.2.7",
    "heic2any": "^0.0.4",
    "immer": "^10.1.3",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.63.0",
    "react-pdf": "^10.2.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "resend": "^6.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.0.0-beta.13",
    "ulid": "^3.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@cloudflare/workers-types": "^4.20251003.0",
    "@eslint/js": "^9.33.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/router-plugin": "^1.133.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "axe-core": "^4.10.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^6.0.3",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.32.0"
  }
}
