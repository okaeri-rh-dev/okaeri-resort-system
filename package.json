{
  "name": "okaeri-resort-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:jwt:cookies": "node scripts/security-audits/run-audit.cjs jwt-cookies",
    "audit:jwt:cookies:bash": "bash -c \"! grep -r 'document\\\\.cookie' src/ api/ --include='*.ts' --include='*.tsx' --include='*.js' --include='*.jsx' | grep -iE '(token|jwt|auth|bearer|session)' || (echo '✅ No JWT cookie usage detected' && exit 0)\"",
    "audit:jwt:cookies:node": "node scripts/security-audits/jwt-audit.cjs",
    "audit:jwt:headers": "node scripts/security-audits/run-audit.cjs headers",
    "audit:jwt:headers:bash": "bash -c \"grep -r 'Authorization.*Bearer' src/ api/ --include='*.ts' --include='*.tsx' && echo '✅ Authorization Bearer headers detected' || (echo '⚠️ WARNING: No Authorization Bearer headers found' && exit 1)\"",
    "audit:jwt:headers:node": "node scripts/security-audits/header-audit.cjs",
    "audit:jwt:no-cookies": "node scripts/security-audits/run-audit.cjs no-cookies",
    "audit:jwt:no-cookies:bash": "bash -c \"! grep -rE '(Set-Cookie|withCredentials|credentials.*include)' src/ api/ --include='*.ts' --include='*.tsx' | grep -iE '(token|jwt|auth)' || (echo '✅ No cookie-based auth patterns' && exit 0)\"",
    "audit:jwt:no-cookies:node": "node scripts/security-audits/no-cookies-audit.cjs",
    "audit:jwt:production": "NODE_ENV=production node scripts/security-audits/storage-audit-enhanced.cjs",
    "audit:jwt:storage": "node scripts/security-audits/run-audit.cjs storage",
    "audit:jwt:storage:bash": "bash -c \"! grep -r 'localStorage.*token\\|localStorage.*jwt\\|localStorage.*auth' src/ --include='*.ts' --include='*.tsx' --exclude-dir='__tests__' --exclude='*.test.ts' --exclude='*.test.tsx' && echo '✅ No localStorage token usage detected (secure memory-only storage)' || (echo '❌ ERROR: localStorage token usage detected - security violation! Tokens must be stored in memory only' && exit 1)\"",
    "audit:jwt:storage:enhanced": "node scripts/security-audits/storage-audit-enhanced.cjs",
    "audit:jwt:storage:node": "node scripts/security-audits/storage-audit.cjs",
    "build": "vite build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:profile": "tsc -b && vite build --profile",
    "build:with-tsc": "tsc -b && vite build",
    "db:cleanup:test": "tsx scripts/cleanup-test.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:create": "tsx scripts/create-migration.ts",
    "db:migrate:down": "tsx -e \"import('./src/lib/db/migrate.js').then(m => m.rollbackMigration(undefined, {verbose: true}))\"",
    "db:migrate:status": "tsx -e \"import('./src/lib/db/migrate.js').then(m => m.getMigrationStatus().then(console.log))\"",
    "db:migrate:up": "tsx -e \"import('./src/lib/db/migrate.js').then(m => m.runGlobalMigrations({verbose: true}))\"",
    "db:push": "drizzle-kit push:pg",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "tsx scripts/seed.ts --production",
    "db:seed:test": "tsx scripts/seed.ts --test",
    "db:studio": "drizzle-kit studio",
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:network": "vite --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse:accessibility": "mkdir -p reports && lighthouse http://localhost:4173 --only-categories=accessibility --output=json --output-path=./reports/lighthouse-accessibility.json",
    "lighthouse:performance": "mkdir -p reports && lighthouse http://localhost:4173 --preset=desktop --output=json --output-path=./reports/lighthouse-performance.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "perf:audit": "npm run build && mkdir -p reports && start-server-and-test preview http://localhost:4173 'lighthouse http://localhost:4173 --output=html --output-path=./reports/lighthouse-report.html --chrome-flags=\"--headless\"'",
    "perf:budget": "npm run build && bundlesize --enable-github-checks",
    "perf:budget-ci": "npm run build && bundlesize --enable-github-checks --json > bundle-report.json",
    "perf:test-3g": "npm run build && mkdir -p reports && start-server-and-test preview http://localhost:4173 'lighthouse http://localhost:4173 --throttling-method=devtools --throttling.cpuSlowdownMultiplier=4 --throttling.requestLatencyMs=560 --throttling.downloadThroughputKbps=1474 --throttling.uploadThroughputKbps=675 --output=json --output-path=./reports/lighthouse-3g.json'",
    "prepare": "husky",
    "preview": "vite preview --port 4173",
    "pwa:validate": "npm run build && pwa-asset-generator validate",
    "scaffold:all-phases": "node scripts/scaffold-phase.cjs all",
    "scaffold:all-phases:bash": "npm run scaffold:phase2:bash && npm run scaffold:phase3:bash && npm run scaffold:phase4:bash && npm run scaffold:phase5:bash",
    "scaffold:phase1": "echo 'See docs/implementation/phases/phase-1-login-tdd/PHASE_1_FORM_TEST_SPECIFICATIONS.md for test specifications'",
    "scaffold:phase2": "node scripts/scaffold-phase.cjs 2",
    "scaffold:phase2:bash": "mkdir -p src/features/dashboard/{components,hooks,stores,types,__tests__} && touch src/features/dashboard/__tests__/.gitkeep && echo 'Phase 2: Dashboard structure created'",
    "scaffold:phase2:dirs": "npm run scaffold:phase2",
    "scaffold:phase3": "node scripts/scaffold-phase.cjs 3",
    "scaffold:phase3:bash": "mkdir -p src/features/booking/{components,hooks,stores,types,__tests__} && touch src/features/booking/__tests__/.gitkeep && echo 'Phase 3: Booking structure created'",
    "scaffold:phase3:dirs": "npm run scaffold:phase3",
    "scaffold:phase4": "node scripts/scaffold-phase.cjs 4",
    "scaffold:phase4:bash": "mkdir -p src/features/financial/{components,hooks,stores,types,__tests__} && touch src/features/financial/__tests__/.gitkeep && echo 'Phase 4: Financial structure created'",
    "scaffold:phase4:dirs": "npm run scaffold:phase4",
    "scaffold:phase5": "node scripts/scaffold-phase.cjs 5",
    "scaffold:phase5:bash": "echo 'Phase 5: Deployment - See docs/implementation/phases/phase-5-deployment/README.md' && mkdir -p src/features/deployment/{components,utils,__tests__} tests/e2e/deployment && touch src/features/deployment/__tests__/.gitkeep tests/e2e/deployment/.gitkeep",
    "scaffold:phase5:dirs": "npm run scaffold:phase5",
    "security:csp": "./scripts/validate-security-headers.sh",
    "security:headers": "./scripts/validate-security-headers.sh",
    "security:jwt:dev": "NODE_ENV=development VITE_MOCK_AUTH=true npm run audit:jwt:storage:enhanced",
    "security:jwt:full": "node scripts/security-audits/run-audit.cjs all",
    "security:jwt:full:sequential": "npm run audit:jwt:cookies && npm run audit:jwt:storage:enhanced && npm run audit:jwt:headers && npm run audit:jwt:no-cookies",
    "security:jwt:prod": "npm run audit:jwt:production",
    "security:jwt:quick": "npm run audit:jwt:cookies && npm run audit:jwt:no-cookies",
    "security:owasp": "./scripts/validate-security-headers.sh",
    "test": "vitest",
    "test:accessibility:local": "./scripts/test-accessibility-local.sh",
    "test:auth": "vitest src/**/__tests__/**/*.test.{ts,tsx}",
    "test:ci:simulation": "npm run test:performance:local && npm run test:accessibility:local",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:coverage:quick": "vitest run --coverage --reporter=dot src/**/*.test.{ts,tsx}",
    "test:db": "vitest tests/db",
    "test:db:connection": "vitest tests/db/connection.test.ts",
    "test:db:isolation": "vitest tests/db/isolation.test.ts",
    "test:db:performance": "vitest tests/db/performance.test.ts",
    "test:db:schema": "vitest tests/db/schema.test.ts",
    "test:db:utils": "vitest tests/db/utils.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:gates": "npm run test:ci:simulation",
    "test:load": "./scripts/run-load-tests.sh",
    "test:load:smoke": "./scripts/run-load-tests.sh smoke",
    "test:load:spike": "./scripts/run-load-tests.sh spike",
    "test:load:staging": "./scripts/run-load-tests.sh load staging",
    "test:load:stress": "./scripts/run-load-tests.sh stress",
    "test:performance:local": "./scripts/test-performance-local.sh",
    "test:phase1": "vitest run src/features/auth/**/__tests__/*.test.{ts,tsx}",
    "test:phase1:coverage": "vitest run --coverage src/features/auth/**/__tests__/*.test.{ts,tsx}",
    "test:phase1:watch": "vitest watch src/features/auth/**/__tests__/*.test.{ts,tsx}",
    "test:phase2": "vitest run src/features/dashboard/**/__tests__/*.test.{ts,tsx}",
    "test:phase2:coverage": "vitest run --coverage src/features/dashboard/**/__tests__/*.test.{ts,tsx}",
    "test:phase2:watch": "vitest watch src/features/dashboard/**/__tests__/*.test.{ts,tsx}",
    "test:phase3": "vitest run src/features/booking/**/__tests__/*.test.{ts,tsx}",
    "test:phase3:coverage": "vitest run --coverage src/features/booking/**/__tests__/*.test.{ts,tsx}",
    "test:phase3:watch": "vitest watch src/features/booking/**/__tests__/*.test.{ts,tsx}",
    "test:phase4": "vitest run src/features/financial/**/__tests__/*.test.{ts,tsx}",
    "test:phase4:coverage": "vitest run --coverage src/features/financial/**/__tests__/*.test.{ts,tsx}",
    "test:phase4:watch": "vitest watch src/features/financial/**/__tests__/*.test.{ts,tsx}",
    "test:phase5": "vitest run src/features/deployment/**/__tests__/*.test.{ts,tsx} && playwright test tests/e2e/deployment",
    "test:phase5:coverage": "vitest run --coverage src/features/deployment/**/__tests__/*.test.{ts,tsx}",
    "test:phase5:watch": "vitest watch src/features/deployment/**/__tests__/*.test.{ts,tsx}",
    "test:runtime-errors": "playwright test runtime-errors.spec.ts",
    "test:runtime-errors:debug": "playwright test runtime-errors.spec.ts --debug",
    "test:ui": "vitest --ui",
    "test:utilities": "vitest src/utils/**/__tests__/*.test.{ts,tsx} src/lib/**/__tests__/*.test.{ts,tsx}",
    "type-check": "tsc --noEmit",
    "verify": "npm run verify:all",
    "verify:accessibility": "npm run build && mkdir -p reports && start-server-and-test preview http://localhost:4173 'lighthouse http://localhost:4173 --only-categories=accessibility --output=json --output-path=./reports/lighthouse-accessibility.json'",
    "verify:all": "npm run verify:tests && npm run verify:coverage:paths && npm run verify:types && npm run verify:lint && npm run verify:security",
    "verify:bundle": "npm run perf:budget",
    "verify:coverage:paths": "node scripts/check-coverage.js",
    "verify:jwt": "vitest run src/__tests__/security/jwt.security.test.ts --reporter=verbose && npm run security:jwt:full",
    "verify:lint": "eslint . --max-warnings 0",
    "verify:performance": "npm run build && mkdir -p reports && start-server-and-test preview http://localhost:4173 'lighthouse http://localhost:4173 --preset=desktop --output=json --output-path=./reports/lighthouse-performance.json'",
    "verify:push": "npm run verify:all && npm run verify:bundle && npm run verify:performance && npm run verify:accessibility",
    "verify:security": "npm audit --audit-level=high && npm run security:jwt:full",
    "verify:tests": "vitest run --coverage",
    "verify:types": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.1.5",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.114.3",
    "@types/decimal.js": "^0.0.32",
    "@upstash/ratelimit": "^1.0.0",
    "@upstash/redis": "^1.28.0",
    "@vercel/node": "^3.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.30.10",
    "immer": "^10.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "pg": "^8.11.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-error-boundary": "^4.1.2",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.0.0-beta.13",
    "ws": "^8.16.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/react": "^4.8.2",
    "@eslint/js": "^9.33.0",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query-devtools": "^5.85.5",
    "@tanstack/router-vite-plugin": "^1.131.27",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest-axe": "^3.5.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.9",
    "@types/pg": "^8.10.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "axe-core": "^4.10.3",
    "bundlesize": "^0.18.2",
    "dotenv": "^17.2.1",
    "drizzle-kit": "^0.21.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.2.11",
    "msw": "^2.0.11",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rollup-plugin-visualizer": "^6.0.3",
    "shadcn": "^3.0.0",
    "start-server-and-test": "^2.0.13",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "uuid": "^11.1.0",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
