{
  "name": "okaeri-resort",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:dev": "tsc -b && vite build",
    "build:full": "npm run build && npm run build:functions",
    "build:functions": "rm -rf dist/functions && cp -r functions dist/functions",
    "build:size": "node scripts/bundle-size.js",
    "clean": "rm -rf dist node_modules/.vite functions/.wrangler",
    "cleanup:e2e": "tsx scripts/e2e/cleanup.ts",
    "deploy": "npm run build:full && npx wrangler pages deploy dist",
    "deploy:preview": "npm run build:full && npx wrangler pages deploy dist --branch preview",
    "dev": "vite",
    "dev:cf": "concurrently \"npm:dev:vite\" \"npm:dev:wrangler\" --kill-others",
    "dev:vite": "vite --clearScreen false",
    "dev:wrangler": "wrangler pages dev . --compatibility-date=2025-09-29 --compatibility-flags=nodejs_compat --port 8788 --local",
    "drift:prod": "sh scripts/drift-check.sh",
    "e2e:dev": "playwright test e2e/booking-card-mobile.spec.ts --project=\"Mobile Chrome\"",
    "format": "prettier --write .",
    "gen:types": "sh scripts/gen-types.sh",
    "generate:routes": "node scripts/generate-routes.mjs",
    "health-check": "bash scripts/health-check.sh",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "preflight:e2e": "tsx scripts/e2e/preflight.ts",
    "prepare": "husky",
    "preview": "vite preview",
    "seed:e2e": "tsx scripts/e2e/seed.ts",
    "seed:roles:dev": "tsx scripts/seed-dev-roles.ts",
    "seed:roles:verify": "tsx scripts/verify-roles.ts",
    "seed:test-users": "node scripts/seed-test-users.mjs",
    "test": "vitest",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run src/__tests__/database __tests__/database",
    "test:e2e": "playwright test",
    "test:e2e:hooked": "bash scripts/e2e/run-hooked.sh",
    "test:integration": "vitest run __tests__/integration",
    "test:load": "k6 run load-testing/scenarios/mixed-workload.ts",
    "test:load:availability": "k6 run load-testing/scenarios/availability-check.ts",
    "test:load:booking": "k6 run load-testing/scenarios/guest-booking.ts",
    "test:load:smoke": "k6 run --vus 1 --duration 30s load-testing/scenarios/mixed-workload.ts",
    "test:load:stress": "k6 run --stage 10s:10,1m:50,30s:100,1m:100,30s:0 load-testing/scenarios/mixed-workload.ts",
    "test:no-db": "vitest run --exclude 'src/__tests__/database/**' --exclude '__tests__/database/**' --exclude 'src/__tests__/performance/multi-unit-availability.test.ts'",
    "test:performance": "vitest run --grep performance",
    "test:run": "vitest run",
    "test:security": "vitest run --grep security",
    "test:shard": "vitest run --shard",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run src/components src/hooks src/lib src/stores src/utils",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.tests.json",
    "verify": "npm run type-check && npm run lint && npm run test:run",
    "verify:fix": "npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "^8.21.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.2.7",
    "immer": "^11.1.21",
    "lucide-react": "^0.469.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-pdf": "^10.2.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "ulid": "^3.0.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@eslint/js": "^9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/router-generator": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "concurrently": "^9.2.1",
    "culori": "^4.0.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.33.0",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fast-check": "^4.10.2",
    "globals": "^16.3.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^27.4.0",
    "knip": "^6.41.0",
    "lint-staged": "^15.2.11",
    "msw": "^2.11.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.149.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.3",
    "canvas": "^3.2.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
