# Okaeri Resort System - Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================

# Supabase Project URL (get from your Supabase dashboard)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for frontend, get from Supabase dashboard)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (backend only - NEVER expose to frontend!)
# Used in serverless functions for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# CLOUDFLARE CONFIGURATION
# =============================================================================

# Cloudflare Turnstile Site Key (frontend - visible to users)
# Get from: https://dash.cloudflare.com/turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Cloudflare Turnstile Secret Key (backend only)
# Used for server-side CAPTCHA verification
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Note: Cloudflare KV namespace is configured in wrangler.toml, not here
# To create KV namespace:
# npx wrangler kv:namespace create "RATE_LIMIT_KV"
# npx wrangler kv:namespace create "RATE_LIMIT_KV" --preview

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================

# Resend API Key (backend only)
# Get from: https://resend.com/api-keys
# Used for sending booking confirmation emails
RESEND_API_KEY=re_your-resend-api-key

# =============================================================================
# VERCEL DEPLOYMENT (Optional)
# =============================================================================

# These are set automatically by Vercel, but can be configured for local testing
# VERCEL_ENV=development|preview|production
# VERCEL_URL=your-deployment-url.vercel.app

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================

# Development mode settings
# VITE_DEV_MODE=true

# Enable debug logging (frontend)
# VITE_DEBUG=true

# =============================================================================
# DEVELOPMENT SECURITY BYPASS (Optional - Local Development Only)
# =============================================================================

# Skip Turnstile CAPTCHA in development (frontend)
# Set to "true" to bypass the CAPTCHA widget during local development
# This removes the CAPTCHA friction and shows a development mode indicator
# VITE_SKIP_TURNSTILE=true

# Alternatively, use Cloudflare's test keys for automatic pass-through:
# Frontend test key (always passes):
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Backend test key (always passes):
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Note: Backend automatically skips Turnstile verification if TURNSTILE_SECRET_KEY is not set

# Rate limiting is automatically disabled in development when ENVIRONMENT=development
# This is set automatically by wrangler during local development

# =============================================================================
# RECOMMENDED DEVELOPMENT CONFIGURATION
# =============================================================================

# Option 1: Complete bypass (fastest development)
# - Comment out both TURNSTILE keys
# - Set VITE_SKIP_TURNSTILE=true
# - Result: No CAPTCHA, unlimited API requests

# Option 2: Test keys (realistic testing)
# - Use Cloudflare test keys (shown above)
# - Leave VITE_SKIP_TURNSTILE commented out
# - Result: CAPTCHA always passes, unlimited API requests

# Option 3: Full security (production-like)
# - Use real Turnstile keys
# - Leave VITE_SKIP_TURNSTILE commented out
# - Result: Real CAPTCHA, but with relaxed rate limits (100x in dev)

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================

# Before deploying to production, ensure you have:
# 1. [ ] Created a Supabase project and obtained all keys
# 2. [ ] Set up Cloudflare Turnstile and obtained site/secret keys
# 3. [ ] Created Cloudflare KV namespace for rate limiting
# 4. [ ] Set up Resend account and obtained API key
# 5. [ ] Run database migrations: npm run db:migrate
# 6. [ ] Applied the exclusion constraint migration (014)
# 7. [ ] Configured all environment variables in Vercel dashboard
# 8. [ ] Set up secrets in Vercel using: npx wrangler secret put <SECRET_NAME>

# =============================================================================
# SECURITY NOTES
# =============================================================================

# NEVER commit actual values to version control!
# - Keep .env.local in .gitignore
# - Use Vercel/Cloudflare secrets for production
# - Rotate keys regularly
# - Service role keys should ONLY be used in backend/serverless functions