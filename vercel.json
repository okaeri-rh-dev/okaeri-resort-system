{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "okaeri-resort-system",
  "alias": ["okaeri-resort.vercel.app"],

  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --prefer-offline --no-audit",

  "framework": "vite",
  "nodeVersion": "20.x",

  "functions": {
    "api/auth/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1", "hnd1"],
      "maxDuration": 10,
      "memory": 256,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "3",
        "JWT_EXPIRES_IN": "15m",
        "REFRESH_TOKEN_EXPIRES_IN": "7d",
        "SESSION_TIMEOUT": "3600000",
        "RATE_LIMIT_MAX": "30",
        "RATE_LIMIT_WINDOW": "900000",
        "BCRYPT_ROUNDS": "12",
        "LOGIN_ATTEMPT_LIMIT": "5",
        "LOGIN_ATTEMPT_WINDOW": "900000"
      }
    },
    "api/bookings/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1", "hnd1"],
      "maxDuration": 20,
      "memory": 768,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "8",
        "RATE_LIMIT_MAX": "60",
        "RATE_LIMIT_WINDOW": "600000",
        "BOOKING_HOLD_TIME": "600000",
        "MAX_CONCURRENT_BOOKINGS": "5"
      }
    },
    "api/rooms/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1", "hnd1"],
      "maxDuration": 15,
      "memory": 512,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "5",
        "RATE_LIMIT_MAX": "120",
        "RATE_LIMIT_WINDOW": "600000",
        "CACHE_TTL": "300"
      }
    },
    "api/reports/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1"],
      "maxDuration": 25,
      "memory": 1024,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "10",
        "RATE_LIMIT_MAX": "20",
        "RATE_LIMIT_WINDOW": "1800000",
        "REPORT_TIMEOUT": "20000",
        "MAX_REPORT_ROWS": "10000"
      }
    },
    "api/upload/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1", "hnd1"],
      "maxDuration": 25,
      "memory": 1024,
      "environment": {
        "NODE_ENV": "production",
        "RATE_LIMIT_MAX": "10",
        "RATE_LIMIT_WINDOW": "3600000",
        "MAX_FILE_SIZE": "10485760",
        "ALLOWED_MIME_TYPES": "image/jpeg,image/png,image/webp,application/pdf",
        "UPLOAD_TIMEOUT": "20000"
      }
    },
    "api/health-check.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1", "hnd1"],
      "maxDuration": 5,
      "memory": 128,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "1",
        "HEALTH_CHECK_TIMEOUT": "3000"
      }
    },
    "api/maintenance/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1"],
      "maxDuration": 25,
      "memory": 1024,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "15",
        "RATE_LIMIT_MAX": "5",
        "RATE_LIMIT_WINDOW": "3600000",
        "MAINTENANCE_TIMEOUT": "20000"
      }
    },
    "api/**/*.ts": {
      "runtime": "nodejs20.x",
      "regions": ["sin1", "hnd1"],
      "maxDuration": 15,
      "memory": 512,
      "environment": {
        "NODE_ENV": "production",
        "DATABASE_MAX_CONNECTIONS": "5",
        "RATE_LIMIT_MAX": "100",
        "RATE_LIMIT_WINDOW": "600000",
        "DEFAULT_TIMEOUT": "10000"
      }
    }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'nonce-{NONCE}' https://vercel.live https://vercel.com https://vitals.vercel-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://*.neon.tech wss://*.neon.tech https://api.cloudflare.com https://vitals.vercel-analytics.com https://api.pwnedpasswords.com; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; require-trusted-types-for 'script'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Feature-Policy",
          "value": "camera 'none'; microphone 'none'; geolocation 'none'; payment 'none'"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "X-Download-Options",
          "value": "noopen"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, nosnippet, noarchive, notranslate, noimageindex"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "Vary",
          "value": "Accept-Encoding"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "$VERCEL_URL"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS, PATCH"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, X-API-Key, Accept, Origin, X-Project-ID, X-Session-ID"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), magnetometer=(), gyroscope=(), accelerometer=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(favicon\\.ico|robots\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/health-check",
      "destination": "/api/health-check"
    },
    {
      "source": "/((?!api|assets|icons|screenshots|sw\\.js|manifest\\.json|favicon\\.ico|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],

  "redirects": [
    {
      "source": "/home",
      "destination": "/dashboard",
      "permanent": true,
      "statusCode": 301
    },
    {
      "source": "/admin",
      "destination": "/dashboard",
      "permanent": true,
      "statusCode": 301
    }
  ],

  "regions": ["sin1", "hnd1"],

  "env": {
    "NODE_ENV": "production",
    "VITE_APP_VERSION": "@vercel-git-commit-sha",
    "VITE_BUILD_TIME": "@now-iso",
    "VITE_DEPLOYMENT_URL": "@vercel-url",
    "VERCEL_ENV": "@vercel-env",
    "DDOS_PROTECTION_ENABLED": "true",
    "SECURITY_HEADERS_ENABLED": "true",
    "WAF_MODE": "enabled",
    "COST_MONITORING_ENABLED": "true",
    "BANDWIDTH_LIMIT_GB": "95",
    "EXECUTION_LIMIT_GB_HOURS": "95",
    "SECURITY_SCAN_ENABLED": "true"
  },

  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=4096",
      "VITE_NODE_ENV": "production",
      "CI": "true",
      "SECURITY_BUILD_CHECKS": "true",
      "DEPENDENCY_SECURITY_AUDIT": "true",
      "BUILD_SECURITY_SCAN": "true"
    }
  },

  "crons": [
    {
      "path": "/api/health-check",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cleanup-sessions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/maintenance/optimize-database",
      "schedule": "0 3 * * 0"
    }
  ],

  "cleanUrls": true,
  "trailingSlash": false,

  "github": {
    "enabled": true,
    "autoAlias": true,
    "autoJobCancelation": true
  },

  "outputFileTracing": true,
  "speedInsights": {
    "enabled": true
  },
  "webAnalytics": {
    "enabled": true
  }
}
