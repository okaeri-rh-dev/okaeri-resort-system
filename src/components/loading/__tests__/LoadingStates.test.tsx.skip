import React from 'react';
import { render, screen, waitFor, fireEvent } from '@testing-library/react';
import { vi, describe, it, expect, beforeEach } from 'vitest';
import '@testing-library/jest-dom';

import { SmartLoading } from '../SmartLoading';
import { AccessibleLoading } from '../AccessibleLoading';
import { MobileCardLoading, TouchOptimizedLoading } from '../MobileOptimized';
import {
  BookingsTableSkeleton,
  UnitsTableSkeleton,
  GuestsTableSkeleton,
  DashboardStatsSkeleton,
  BookingFormSkeleton,
} from '@/components/skeletons';

// ============================================
// MOCK UTILITIES
// ============================================

const createMockQuery = (isLoading = false, isError = false, error = null) => ({
  isLoading,
  isError,
  error,
  data: isLoading ? undefined : { test: 'data' },
});

// Mock IntersectionObserver
class MockIntersectionObserver {
  callback: IntersectionObserverCallback;
  constructor(callback: IntersectionObserverCallback) {
    this.callback = callback;
  }
  observe = vi.fn();
  disconnect = vi.fn();
  unobserve = vi.fn();
}

// Mock network information
const mockConnection = {
  effectiveType: '4g',
  downlink: 10,
  rtt: 50,
  addEventListener: vi.fn(),
  removeEventListener: vi.fn(),
};

beforeEach(() => {
  // Reset all mocks
  vi.clearAllMocks();

  // Mock IntersectionObserver
  global.IntersectionObserver = MockIntersectionObserver as any;

  // Mock Navigator properties
  Object.defineProperty(navigator, 'connection', {
    value: mockConnection,
    configurable: true,
  });

  Object.defineProperty(navigator, 'deviceMemory', {
    value: 8,
    configurable: true,
  });

  Object.defineProperty(navigator, 'hardwareConcurrency', {
    value: 8,
    configurable: true,
  });

  // Mock window.matchMedia for reduced motion
  Object.defineProperty(window, 'matchMedia', {
    writable: true,
    value: vi.fn().mockImplementation(query => ({
      matches: false,
      media: query,
      onchange: null,
      addListener: vi.fn(),
      removeListener: vi.fn(),
      addEventListener: vi.fn(),
      removeEventListener: vi.fn(),
      dispatchEvent: vi.fn(),
    })),
  });
});

// ============================================
// SMART LOADING TESTS
// ============================================

describe('SmartLoading', () => {
  it('shows skeleton while loading', async () => {
    const mockQuery = createMockQuery(true);

    render(
      <SmartLoading
        query={mockQuery}
        skeletonType="text"
        data-testid="smart-loading"
      >
        <div data-testid="content">Loaded content</div>
      </SmartLoading>
    );

    expect(screen.queryByTestId('content')).not.toBeInTheDocument();
    expect(screen.getByTestId('smart-loading')).toBeInTheDocument();
  });

  it('shows content when loaded', () => {
    const mockQuery = createMockQuery(false);

    render(
      <SmartLoading query={mockQuery}>
        <div data-testid="content">Loaded content</div>
      </SmartLoading>
    );

    expect(screen.getByTestId('content')).toBeInTheDocument();
    expect(screen.getByText('Loaded content')).toBeInTheDocument();
  });

  it('shows error state when query fails', () => {
    const mockQuery = createMockQuery(false, true, { message: 'Network error' });

    render(
      <SmartLoading query={mockQuery}>
        <div data-testid="content">Loaded content</div>
      </SmartLoading>
    );

    expect(screen.getByText('Error loading data')).toBeInTheDocument();
    expect(screen.getByText('Network error')).toBeInTheDocument();
    expect(screen.queryByTestId('content')).not.toBeInTheDocument();
  });

  it('handles multiple queries correctly', () => {
    const queries = [
      createMockQuery(true),
      createMockQuery(false),
    ];

    render(
      <SmartLoading query={queries}>
        <div data-testid="content">Loaded content</div>
      </SmartLoading>
    );

    // Should show loading if any query is loading
    expect(screen.queryByTestId('content')).not.toBeInTheDocument();
  });

  it('respects minimum loading time', async () => {
    const mockQuery = createMockQuery(true);

    const { rerender } = render(
      <SmartLoading
        query={mockQuery}
        minLoadingTime={500}
        data-testid="smart-loading"
      >
        <div data-testid="content">Loaded content</div>
      </SmartLoading>
    );

    // Simulate data loading immediately
    rerender(
      <SmartLoading
        query={createMockQuery(false)}
        minLoadingTime={500}
        data-testid="smart-loading"
      >
        <div data-testid="content">Loaded content</div>
      </SmartLoading>
    );

    // Should still show loading due to minimum time
    expect(screen.queryByTestId('content')).not.toBeInTheDocument();

    // Wait for minimum time to pass
    await waitFor(
      () => {
        expect(screen.getByTestId('content')).toBeInTheDocument();
      },
      { timeout: 600 }
    );
  });
});

// ============================================
// ACCESSIBLE LOADING TESTS
// ============================================

describe('AccessibleLoading', () => {
  it('has proper ARIA attributes when loading', () => {
    render(
      <AccessibleLoading
        isLoading={true}
        loadingText="Loading bookings"
        data-testid="accessible-loading"
      >
        <div>Content</div>
      </AccessibleLoading>
    );

    const loadingElement = screen.getByTestId('accessible-loading');
    expect(loadingElement).toHaveAttribute('role', 'region');
    expect(loadingElement).toHaveAttribute('aria-busy', 'true');
    expect(loadingElement).toHaveAttribute('aria-label', 'Loading bookings');
    expect(loadingElement).toHaveAttribute('aria-live', 'polite');
  });

  it('announces loading completion', () => {
    const { rerender } = render(
      <AccessibleLoading
        isLoading={true}
        announceComplete={true}
        data-testid="accessible-loading"
      >
        <div>Content</div>
      </AccessibleLoading>
    );

    rerender(
      <AccessibleLoading
        isLoading={false}
        announceComplete={true}
        data-testid="accessible-loading"
      >
        <div>Content</div>
      </AccessibleLoading>
    );

    const loadingElement = screen.getByTestId('accessible-loading');
    expect(loadingElement).toHaveAttribute('aria-busy', 'false');
    expect(screen.getByText('Content loaded successfully')).toBeInTheDocument();
  });

  it('provides screen reader text', () => {
    render(
      <AccessibleLoading
        isLoading={true}
        loadingText="Loading data"
        description="Please wait while we fetch your information"
      >
        <div>Content</div>
      </AccessibleLoading>
    );

    expect(screen.getByText('Loading data. Please wait while we fetch your information')).toBeInTheDocument();
  });
});

// ============================================
// MOBILE OPTIMIZED TESTS
// ============================================

describe('MobileCardLoading', () => {
  it('renders specified number of cards', () => {
    render(<MobileCardLoading count={3} data-testid="mobile-cards" />);

    const container = screen.getByTestId('mobile-cards');
    const cards = container.querySelectorAll('[class*="border"]');
    expect(cards).toHaveLength(3);
  });

  it('progressive loading for large lists', async () => {
    render(<MobileCardLoading count={15} data-testid="mobile-cards" />);

    const container = screen.getByTestId('mobile-cards');

    // Should initially show batch size (default 5 for test environment)
    let cards = container.querySelectorAll('[class*="border"]');
    expect(cards.length).toBeLessThanOrEqual(10);

    // Wait for progressive loading
    await waitFor(
      () => {
        const updatedCards = container.querySelectorAll('[class*="border"]');
        expect(updatedCards.length).toBeGreaterThan(5);
      },
      { timeout: 1000 }
    );
  });
});

describe('TouchOptimizedLoading', () => {
  it('handles pull to refresh gesture', () => {
    const mockOnPullToRefresh = vi.fn();

    render(
      <TouchOptimizedLoading
        isLoading={false}
        onPullToRefresh={mockOnPullToRefresh}
        data-testid="touch-loading"
      >
        <div>Content</div>
      </TouchOptimizedLoading>
    );

    const container = screen.getByTestId('touch-loading');

    // Simulate touch events
    fireEvent.touchStart(container, {
      touches: [{ clientY: 100 }],
    });

    fireEvent.touchMove(container, {
      touches: [{ clientY: 200 }],
    });

    fireEvent.touchEnd(container);

    // Verify pull to refresh was triggered
    expect(mockOnPullToRefresh).toHaveBeenCalled();
  });

  it('shows loading overlay when loading', () => {
    render(
      <TouchOptimizedLoading isLoading={true} data-testid="touch-loading">
        <div>Content</div>
      </TouchOptimizedLoading>
    );

    expect(screen.getByText('Refreshing...')).toBeInTheDocument();
  });
});

// ============================================
// SKELETON COMPONENT TESTS
// ============================================

describe('BookingsTableSkeleton', () => {
  it('renders mobile version correctly', () => {
    render(<BookingsTableSkeleton isMobile={true} rows={5} />);

    expect(screen.getAllByRole('button')).toHaveLength(2); // Assuming filter buttons
  });

  it('renders desktop version correctly', () => {
    render(<BookingsTableSkeleton isMobile={false} rows={8} />);

    // Should render table structure
    const container = document.querySelector('[class*="enterprise-table"]');
    expect(container).toBeInTheDocument();
  });
});

describe('DashboardStatsSkeleton', () => {
  it('renders specified number of KPI cards', () => {
    render(<DashboardStatsSkeleton cardCount={6} />);

    // Check for grid container
    const gridContainer = document.querySelector('[class*="grid"]');
    expect(gridContainer).toBeInTheDocument();
  });
});

describe('BookingFormSkeleton', () => {
  it('renders different steps correctly', () => {
    const { rerender } = render(<BookingFormSkeleton currentStep={1} />);

    // Check step 1 structure
    expect(document.querySelector('[class*="grid"]')).toBeInTheDocument();

    // Change to step 2
    rerender(<BookingFormSkeleton currentStep={2} />);

    // Check step 2 structure
    expect(document.querySelector('[class*="space-y-6"]')).toBeInTheDocument();
  });

  it('shows progress indicator', () => {
    render(<BookingFormSkeleton currentStep={2} />);

    // Should show 4 step indicators
    const stepIndicators = document.querySelectorAll('[class*="rounded-full"][class*="border-2"]');
    expect(stepIndicators).toHaveLength(4);
  });
});

// ============================================
// PERFORMANCE TESTS
// ============================================

describe('Performance', () => {
  it('skeleton components render quickly', () => {
    const startTime = performance.now();

    render(
      <div>
        <BookingsTableSkeleton rows={10} />
        <UnitsTableSkeleton rows={10} />
        <GuestsTableSkeleton rows={10} />
        <DashboardStatsSkeleton cardCount={8} />
      </div>
    );

    const renderTime = performance.now() - startTime;

    // Should render all skeletons in under 50ms
    expect(renderTime).toBeLessThan(50);
  });

  it('minimal skeleton complexity reduces render time', () => {
    const startTime = performance.now();

    render(<MobileCardLoading count={20} />);

    const renderTime = performance.now() - startTime;

    // Should be reasonably fast even with many items
    expect(renderTime).toBeLessThan(100);
  });
});

// ============================================
// INTEGRATION TESTS
// ============================================

describe('Integration', () => {
  it('works with React Query loading states', async () => {
    const TestComponent = ({ isLoading }: { isLoading: boolean }) => {
      const mockQuery = createMockQuery(isLoading);

      return (
        <SmartLoading
          query={mockQuery}
          data-testid="integration-test"
        >
          <div data-testid="loaded-content">Data loaded</div>
        </SmartLoading>
      );
    };

    const { rerender } = render(<TestComponent isLoading={true} />);

    expect(screen.queryByTestId('loaded-content')).not.toBeInTheDocument();

    rerender(<TestComponent isLoading={false} />);

    await waitFor(() => {
      expect(screen.getByTestId('loaded-content')).toBeInTheDocument();
    });
  });

  it('adapts to different device capabilities', () => {
    // Mock low-end device
    Object.defineProperty(navigator, 'deviceMemory', {
      value: 2,
      configurable: true,
    });

    Object.defineProperty(navigator, 'hardwareConcurrency', {
      value: 2,
      configurable: true,
    });

    render(<MobileCardLoading count={10} data-testid="low-end-loading" />);

    // Should adapt loading strategy for low-end devices
    const container = screen.getByTestId('low-end-loading');
    expect(container).toBeInTheDocument();
  });
});

// ============================================
// ACCESSIBILITY TESTS
// ============================================

describe('Accessibility', () => {
  it('skeletons do not interfere with screen readers', () => {
    render(
      <AccessibleLoading isLoading={true} loadingText="Loading content">
        <div>Hidden content</div>
      </AccessibleLoading>
    );

    // Skeleton should be aria-hidden
    const skeletonElements = document.querySelectorAll('[aria-hidden="true"]');
    expect(skeletonElements.length).toBeGreaterThan(0);
  });

  it('provides proper focus management', () => {
    render(
      <AccessibleLoading isLoading={true} loadingText="Loading content">
        <button>Test button</button>
      </AccessibleLoading>
    );

    // Should have a focusable element for screen readers
    const focusableElement = document.querySelector('[tabindex="0"]');
    expect(focusableElement).toBeInTheDocument();
  });

  it('respects reduced motion preferences', () => {
    // Mock reduced motion preference
    Object.defineProperty(window, 'matchMedia', {
      writable: true,
      value: vi.fn().mockImplementation(query => ({
        matches: query === '(prefers-reduced-motion: reduce)',
        media: query,
        onchange: null,
        addListener: vi.fn(),
        removeListener: vi.fn(),
        addEventListener: vi.fn(),
        removeEventListener: vi.fn(),
        dispatchEvent: vi.fn(),
      })),
    });

    render(
      <AccessibleLoading isLoading={true}>
        <div>Content</div>
      </AccessibleLoading>
    );

    // Animations should be disabled
    const animatedElements = document.querySelectorAll('[class*="animate-pulse"]');
    expect(animatedElements).toHaveLength(0);
  });
});