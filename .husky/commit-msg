# Exit on any failure
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the commit message
commit_message=$(cat "$1")

echo "${BLUE}🔍 Validating commit message format...${NC}"

# Conventional Commits pattern
# Format: type(scope): description
# 
# Types: feat, fix, docs, style, refactor, test, chore, build, ci, perf, revert
# Scope: optional, can be anything relevant to the project
# Description: brief description of changes

# Define the regex pattern for conventional commits
conventional_commit_regex="^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert)(\(.+\))?: .{1,50}"

# Check if commit message matches conventional commit format
if echo "$commit_message" | grep -qE "$conventional_commit_regex"; then
  echo "${GREEN}✅ Commit message follows conventional commit format${NC}"
else
  echo "${RED}❌ Invalid commit message format${NC}"
  echo ""
  echo "${YELLOW}Commit message should follow Conventional Commits specification:${NC}"
  echo "${BLUE}Format: <type>[optional scope]: <description>${NC}"
  echo ""
  echo "${YELLOW}Valid types:${NC}"
  echo "  ${GREEN}feat:${NC}     A new feature"
  echo "  ${GREEN}fix:${NC}      A bug fix"
  echo "  ${GREEN}docs:${NC}     Documentation only changes"
  echo "  ${GREEN}style:${NC}    Changes that do not affect the meaning of the code"
  echo "  ${GREEN}refactor:${NC} A code change that neither fixes a bug nor adds a feature"
  echo "  ${GREEN}test:${NC}     Adding missing tests or correcting existing tests"
  echo "  ${GREEN}chore:${NC}    Changes to the build process or auxiliary tools"
  echo "  ${GREEN}build:${NC}    Changes that affect the build system or dependencies"
  echo "  ${GREEN}ci:${NC}       Changes to our CI configuration files and scripts"
  echo "  ${GREEN}perf:${NC}     A code change that improves performance"
  echo "  ${GREEN}revert:${NC}   Reverts a previous commit"
  echo ""
  echo "${YELLOW}Examples:${NC}"
  echo "  ${GREEN}feat(auth): add user login functionality${NC}"
  echo "  ${GREEN}fix(booking): resolve date validation issue${NC}"
  echo "  ${GREEN}docs: update API documentation${NC}"
  echo "  ${GREEN}chore(deps): update dependencies${NC}"
  echo "  ${GREEN}refactor(utils): simplify date formatting${NC}"
  echo ""
  echo "${YELLOW}Your commit message:${NC}"
  echo "  ${RED}\"$commit_message\"${NC}"
  echo ""
  echo "${YELLOW}Please follow the conventional commit format and try again.${NC}"
  exit 1
fi

# Additional validations

# Check for commit message length (first line should be <= 72 characters)
first_line=$(echo "$commit_message" | head -n 1)
if [ ${#first_line} -gt 72 ]; then
  echo "${YELLOW}⚠️  Warning: First line is longer than 72 characters (${#first_line} chars)${NC}"
  echo "${YELLOW}Consider shortening the description for better readability${NC}"
fi

# Check for imperative mood (starts with lowercase verb)
description=$(echo "$first_line" | sed -E 's/^[a-z]+(\(.+\))?: //')
first_word=$(echo "$description" | cut -d' ' -f1)
if echo "$first_word" | grep -qE '^[A-Z]'; then
  echo "${YELLOW}⚠️  Warning: Description should start with a lowercase verb in imperative mood${NC}"
  echo "${YELLOW}Example: 'add feature' instead of 'Add feature' or 'Added feature'${NC}"
fi

# Check for trailing period
if echo "$first_line" | grep -q '\.$'; then
  echo "${YELLOW}⚠️  Warning: Commit message should not end with a period${NC}"
fi

# Resort Management System specific checks
# Check for relevant scopes
valid_scopes="auth|booking|payment|guest|room|financial|dashboard|api|ui|db|config|deploy|test"
if echo "$first_line" | grep -qE '\(.+\)'; then
  scope=$(echo "$first_line" | sed -E 's/^[a-z]+\((.+)\):.*/\1/')
  if ! echo "$scope" | grep -qE "^($valid_scopes)$"; then
    echo "${YELLOW}💡 Suggestion: Consider using a relevant scope for the resort system:${NC}"
    echo "  ${GREEN}auth${NC} - Authentication and authorization"
    echo "  ${GREEN}booking${NC} - Booking management"
    echo "  ${GREEN}payment${NC} - Payment processing"
    echo "  ${GREEN}guest${NC} - Guest management"
    echo "  ${GREEN}room${NC} - Room management"
    echo "  ${GREEN}financial${NC} - Financial tracking"
    echo "  ${GREEN}dashboard${NC} - Dashboard and analytics"
    echo "  ${GREEN}api${NC} - API endpoints"
    echo "  ${GREEN}ui${NC} - User interface"
    echo "  ${GREEN}db${NC} - Database related"
    echo "  ${GREEN}config${NC} - Configuration"
    echo "  ${GREEN}deploy${NC} - Deployment"
    echo "  ${GREEN}test${NC} - Testing"
  fi
fi

echo "${GREEN}✅ Commit message validation completed${NC}"