#!/bin/sh

# Exit on any failure
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${GREEN}🚀 Running pre-commit checks in parallel...${NC}"
echo "${YELLOW}📝 lint-staged + 🔍 TypeScript + ✨ ESLint (cached)${NC}"

# Workaround for Windows 10, Git Bash, and stdin issues
command_exists () {
  command -v "$1" >/dev/null 2>&1
}

# Fix for TTY issues with Git hooks
if command_exists winpty && test -t 1; then
  exec < /dev/tty
fi

# Phase 1: Run core checks in parallel; any failure blocks the commit
# - lint-staged: Format staged files with Prettier (~1-2s)
# - types: tsc must report zero errors for src, functions and e2e (incremental)
# - lint: ESLint errors block; warnings do not (cached, ~1s warm)
npx concurrently \
  --kill-others-on-fail \
  --names "format,types,lint" \
  --prefix-colors "cyan,yellow,magenta" \
  "npx lint-staged" \
  "npx tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc-precommit.tsbuildinfo && npx tsc --noEmit --incremental -p functions/tsconfig.json && npx tsc --noEmit --incremental -p tsconfig.e2e.json" \
  "npx eslint . --cache --cache-location .eslintcache"

# Phase 2: Quick sequential checks (lightweight, ~1s total)
echo ""
echo "${YELLOW}🔍 Running quick checks...${NC}"

# Get staged files once (avoid repeated git calls)
STAGED_FILES=$(git diff --cached --name-only)

if [ -n "$STAGED_FILES" ]; then
  # Blocking: debugger statements (exclude security files and built assets)
  debugger_files=$(echo "$STAGED_FILES" | grep -v "src/lib/security/secure-token-manager.ts" | grep -v "assets/" | grep -v "\.config\." | xargs grep -l "^[[:space:]]*debugger[[:space:]]*;" 2>/dev/null || true)
  if [ -n "$debugger_files" ]; then
    echo "${RED}❌ Error: Found debugger statements in staged files:${NC}"
    echo "$debugger_files"
    exit 1
  fi

  # Blocking: large files (>1MB, excluding package-lock.json)
  large_files=$(echo "$STAGED_FILES" | grep -v "package-lock.json" | xargs ls -la 2>/dev/null | awk '$5 > 1048576 {print $9, $5}' || true)
  if [ -n "$large_files" ]; then
    echo "${RED}❌ Error: Large files detected (>1MB):${NC}"
    echo "$large_files"
    echo "${RED}Please use Git LFS for large files or exclude them${NC}"
    exit 1
  fi

  # Warnings (non-blocking) - consolidated output
  console_logs=$(echo "$STAGED_FILES" | xargs grep -l "console.log" 2>/dev/null || true)
  if [ -n "$console_logs" ]; then
    echo "${YELLOW}⚠️  Warning: console.log found in staged files${NC}"
  fi

  todo_files=$(echo "$STAGED_FILES" | xargs grep -l "TODO\|FIXME" 2>/dev/null || true)
  if [ -n "$todo_files" ]; then
    echo "${YELLOW}📝 Info: TODO/FIXME comments in staged files${NC}"
  fi

  # Sensitive info check
  sensitive_patterns="password|secret|key|token|credential"
  sensitive_files=$(echo "$STAGED_FILES" | xargs grep -i -l -E "$sensitive_patterns" 2>/dev/null || true)
  if [ -n "$sensitive_files" ]; then
    echo "${YELLOW}🔐 Warning: Potential sensitive information detected - please review${NC}"
  fi
fi

echo "${GREEN}✅ Pre-commit checks completed successfully!${NC}"
