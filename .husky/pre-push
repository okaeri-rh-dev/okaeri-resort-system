#!/bin/sh

# Exit on any failure
set -e

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Fast local feedback only: unit tests affected by this branch. CI (ci.yml) is
# the merge gate and runs type-aware lint, type-check, knip and the full unit
# suite as required checks. DB tests and Playwright E2E run in infra-health and
# manually:
#   npm run test:db
#   npm run test:e2e
if base=$(git rev-parse --verify --quiet '@{upstream}'); then
  changed_flag="--changed=$base"
elif base=$(git merge-base HEAD origin/main 2>/dev/null); then
  changed_flag="--changed=$base"
else
  changed_flag=""
fi

# vitest --changed only follows imports, so config and setup edits would run nothing.
test_infra='^(package(-lock)?\.json|vite(st)?\.config\..*|tsconfig.*\.json|src/test/.*|__tests__/setup/.*)$'
if [ -n "$changed_flag" ] && git diff --name-only "$base" | grep -qE "$test_infra"; then
  changed_flag=""
fi

echo "${GREEN}🚀 Running pre-push unit tests (${changed_flag:-full suite})...${NC}"

SKIP_DB_SETUP=1 npx vitest run $changed_flag --passWithNoTests --fileParallelism \
  --exclude 'src/__tests__/database/**' \
  --exclude '__tests__/database/**' \
  --exclude 'src/__tests__/performance/multi-unit-availability.test.ts'

echo "${GREEN}✅ Pre-push checks passed. ${YELLOW}Full lint/type-check/unit run in CI.${NC}"
