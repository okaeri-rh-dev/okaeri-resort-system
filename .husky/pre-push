#!/bin/sh

# Exit on any failure
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${GREEN}🚀 Running pre-push checks in parallel...${NC}"
echo "${YELLOW}🔍 ESLint (cached) + 🧪 Tests running concurrently...${NC}"

# Run ESLint and tests in parallel using concurrently
# --kill-others-on-fail: Stop all if one fails
# ESLint uses --cache for faster subsequent runs
npx concurrently \
  --kill-others-on-fail \
  --names "lint,test" \
  --prefix-colors "yellow,cyan" \
  "npx eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .eslintcache" \
  "npm run test -- --run"

echo "${GREEN}✅ All pre-push checks passed successfully!${NC}"
