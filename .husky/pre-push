#!/bin/sh

# Exit on any failure
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${GREEN}🚀 Running pre-push checks...${NC}"

# 1. Run ESLint checks
echo "${YELLOW}🔍 Running ESLint checks...${NC}"
npx eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 || {
  echo "${RED}❌ ESLint check failed. Please fix the errors before pushing.${NC}"
  echo "${YELLOW}💡 Tip: Run 'npm run lint:fix' to auto-fix some issues.${NC}"
  exit 1
}
echo "${GREEN}✅ ESLint check passed!${NC}"

# 2. Run tests if they exist and are configured
echo "${YELLOW}🧪 Checking for test scripts...${NC}"
if grep -q '"test:ci"' package.json 2>/dev/null; then
  echo "${YELLOW}🧪 Running tests (CI mode)...${NC}"
  npm run test:ci
elif grep -q '"test"' package.json 2>/dev/null; then
  echo "${YELLOW}🧪 Running tests...${NC}"
  npm run test -- --run --reporter=verbose
else
  echo "${YELLOW}ℹ️  No test script found, skipping tests${NC}"
fi

echo "${GREEN}✅ All pre-push checks passed successfully!${NC}"
