#!/bin/sh

# Exit on any failure
set -e

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "${GREEN}🚀 Running pre-push checks (lint + unit, ~1-2 min)...${NC}"

# Fast, blocking checks only. DB tests (need `supabase start`) and Playwright
# E2E are intentionally NOT run here — they are covered by CI (infra-health
# workflow) and can be run manually:
#   npx vitest run src/__tests__/database __tests__/database src/__tests__/performance/multi-unit-availability.test.ts
#   npm run test:e2e
# NOTE: no `--success first` — exit code must reflect ALL lanes (the old flag
# let a unit-test failure pass because cached lint exited first and green).
npx concurrently \
  --kill-others-on-fail \
  --names "lint,unit" \
  --prefix-colors "yellow,cyan" \
  "npx eslint . --ext .js,.jsx,.ts,.tsx --cache --cache-location .eslintcache" \
  "npx vitest run --exclude 'src/__tests__/database/**' --exclude '__tests__/database/**' --exclude 'src/__tests__/performance/multi-unit-availability.test.ts' --fileParallelism --poolOptions.threads.maxThreads=8"

echo "${GREEN}✅ Pre-push checks passed. DB/E2E suites run in CI and manually (see comments above).${NC}"
