{
  "files": [
    {
      "name": "Main Application Bundle",
      "path": "dist/assets/index-*.js",
      "maxSize": "120kb",
      "compression": "gzip"
    },
    {
      "name": "Critical CSS",
      "path": "dist/assets/index-*.css",
      "maxSize": "40kb",
      "compression": "gzip"
    },
    {
      "name": "React Vendor Bundle",
      "path": "dist/assets/vendor-*.js",
      "maxSize": "42kb",
      "compression": "gzip"
    },
    {
      "name": "Router Bundle (TanStack Router)",
      "path": "dist/assets/chunk-*router*.js",
      "maxSize": "28kb",
      "compression": "gzip"
    },
    {
      "name": "Query Bundle (TanStack Query)",
      "path": "dist/assets/chunk-*query*.js",
      "maxSize": "32kb",
      "compression": "gzip"
    },
    {
      "name": "Critical UI Components",
      "path": "dist/assets/chunk-*ui-critical*.js",
      "maxSize": "38kb",
      "compression": "gzip"
    },
    {
      "name": "Extended UI Components",
      "path": "dist/assets/chunk-*ui-extended*.js",
      "maxSize": "65kb",
      "compression": "gzip"
    },
    {
      "name": "Form Handling Bundle",
      "path": "dist/assets/chunk-*form*.js",
      "maxSize": "22kb",
      "compression": "gzip"
    },
    {
      "name": "State Management Bundle",
      "path": "dist/assets/chunk-*store*.js",
      "maxSize": "15kb",
      "compression": "gzip"
    },
    {
      "name": "Dashboard Route Bundle",
      "path": "dist/assets/dashboard-*.js",
      "maxSize": "35kb",
      "compression": "gzip"
    },
    {
      "name": "Bookings Route Bundle",
      "path": "dist/assets/bookings-*.js",
      "maxSize": "45kb",
      "compression": "gzip"
    },
    {
      "name": "Properties Route Bundle",
      "path": "dist/assets/properties-*.js",
      "maxSize": "30kb",
      "compression": "gzip"
    },
    {
      "name": "Expenses Route Bundle",
      "path": "dist/assets/expenses-*.js",
      "maxSize": "35kb",
      "compression": "gzip"
    },
    {
      "name": "Other Routes Bundle",
      "path": "dist/assets/route-*.js",
      "maxSize": "25kb",
      "compression": "gzip"
    },
    {
      "name": "Public Routes Bundle",
      "path": "dist/assets/public-*.js",
      "maxSize": "20kb",
      "compression": "gzip"
    },
    {
      "name": "Generic Code-Split Chunks",
      "path": "dist/assets/chunk-*.js",
      "maxSize": "25kb",
      "compression": "gzip"
    }
  ],
  "ci": {
    "trackBranches": ["main", "develop"],
    "repoBranchBase": "main",
    "reportBuildStatus": true
  },
  "globalThreshold": {
    "maxSize": "1.5mb",
    "compression": "gzip"
  },
  "defaultCompression": "gzip",
  "algorithm": "gzip",
  "config": {
    "mobile": {
      "maxSize": "400kb",
      "compression": "gzip"
    },
    "desktop": {
      "maxSize": "800kb",
      "compression": "gzip"
    }
  }
}
