{
  "info": {
    "name": "Public Availability Calendar API",
    "description": "Test suite for Phase 1 public availability calendar backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "public-availability-api-v1",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8788",
      "type": "string"
    },
    {
      "key": "api_endpoint",
      "value": "{{base_url}}/api/public/v1/availability",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Happy Path Tests",
      "item": [
        {
          "name": "Get Current Month (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}",
              "host": ["{{api_endpoint}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has correct structure\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('totalUnits');",
                  "    pm.expect(jsonData).to.have.property('dateRange');",
                  "    pm.expect(jsonData).to.have.property('availability');",
                  "    pm.expect(jsonData).to.have.property('metadata');",
                  "});",
                  "",
                  "pm.test(\"Total units is 3\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalUnits).to.eql(3);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Specific Date Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=2025-01-01&end=2025-01-31",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "2025-01-01"
                },
                {
                  "key": "end",
                  "value": "2025-01-31"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Date range matches request\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.dateRange.start).to.eql('2025-01-01');",
                  "    pm.expect(jsonData.dateRange.end).to.eql('2025-01-31');",
                  "});",
                  "",
                  "pm.test(\"Availability array has 31 items\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.availability).to.have.lengthOf(31);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Validation Error Tests",
      "item": [
        {
          "name": "Invalid Date Format",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=invalid&end=2025-01-31",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "invalid"
                },
                {
                  "key": "end",
                  "value": "2025-01-31"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message about invalid format\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('Invalid date format');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "End Date Before Start Date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=2025-01-31&end=2025-01-01",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "2025-01-31"
                },
                {
                  "key": "end",
                  "value": "2025-01-01"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message about date order\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('End date must be after');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Past Date Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=2024-01-01&end=2024-01-31",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "2024-01-01"
                },
                {
                  "key": "end",
                  "value": "2024-01-31"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message about past dates\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('Cannot query past dates');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Future Date Too Far (>1 Year)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=2026-06-01&end=2026-06-30",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "2026-06-01"
                },
                {
                  "key": "end",
                  "value": "2026-06-30"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message about 1 year limit\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('1 year in the future');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Date Range Too Large (>180 Days)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=2025-01-01&end=2026-01-01",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "2025-01-01"
                },
                {
                  "key": "end",
                  "value": "2026-01-01"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error message about 180 day limit\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('180 days');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. CORS Tests",
      "item": [
        {
          "name": "CORS Preflight (OPTIONS)",
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "https://okaeri-resort.com"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": {
              "raw": "{{api_endpoint}}",
              "host": ["{{api_endpoint}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test(\"CORS headers present\", function () {",
                  "    pm.response.to.have.header('Access-Control-Allow-Origin');",
                  "    pm.response.to.have.header('Access-Control-Allow-Methods');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "CORS with Valid Origin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "https://okaeri-resort.com"
              }
            ],
            "url": {
              "raw": "{{api_endpoint}}",
              "host": ["{{api_endpoint}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"CORS origin header matches request\", function () {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql('https://okaeri-resort.com');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Cache Header Tests",
      "item": [
        {
          "name": "Verify Cache-Control Header",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}?start=2025-01-01&end=2025-01-31",
              "host": ["{{api_endpoint}}"],
              "query": [
                {
                  "key": "start",
                  "value": "2025-01-01"
                },
                {
                  "key": "end",
                  "value": "2025-01-31"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Cache-Control header present\", function () {",
                  "    pm.response.to.have.header('Cache-Control');",
                  "    pm.expect(pm.response.headers.get('Cache-Control')).to.include('s-maxage=300');",
                  "});",
                  "",
                  "pm.test(\"ETag header present\", function () {",
                  "    pm.response.to.have.header('ETag');",
                  "});",
                  "",
                  "pm.test(\"Metadata includes cache max age\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.metadata.cacheMaxAge).to.eql(300);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Method Validation Tests",
      "item": [
        {
          "name": "Invalid Method (POST)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}",
              "host": ["{{api_endpoint}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 405\", function () {",
                  "    pm.response.to.have.status(405);",
                  "});",
                  "",
                  "pm.test(\"Error message about method\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.include('Method not allowed');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Rate Limiting Tests",
      "item": [
        {
          "name": "Normal Request (Rate Limit Headers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_endpoint}}",
              "host": ["{{api_endpoint}}"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Rate limit headers present\", function () {",
                  "    pm.response.to.have.header('X-RateLimit-Limit');",
                  "    pm.response.to.have.header('X-RateLimit-Remaining');",
                  "    pm.response.to.have.header('X-RateLimit-Reset');",
                  "});",
                  "",
                  "pm.test(\"Rate limit is 60\", function () {",
                  "    pm.expect(pm.response.headers.get('X-RateLimit-Limit')).to.eql('60');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
